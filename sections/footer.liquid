{%- comment -%}
  Footer (2026 redesign): email sign-up band, brand column + up to four link columns,
  slim legal bar with payment icons.
{%- endcomment -%}
{%- liquid
  assign footer_cols = 0
  for i in (1..4)
    assign key = 'menu_' | append: i
    if section.settings[key] != blank
      assign footer_cols = footer_cols | plus: 1
    endif
  endfor
  if footer_cols == 0
    assign footer_cols = 1
  endif
-%}
{%- style -%}
  .tg-footer { background: #fff; }
  .tg-footer__signup { background: rgb(246 245 242); padding: 3.5rem 0; }
  .tg-footer__main { display: grid; gap: 2.75rem; padding: 3.5rem 0 3rem; }
  .tg-footer__brand { max-width: 22rem; }
  .tg-footer__logo { display: block; width: 150px; margin-bottom: 1.25rem; }
  .tg-footer__tagline { font-size: 14px; line-height: 1.6; color: rgb(109 108 100); margin-bottom: 1.25rem; }
  .tg-footer__contact { display: flex; flex-direction: column; gap: .35rem; font-size: 14px; margin-bottom: 1rem; }
  .tg-footer__menus { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.25rem 1.5rem; }
  .tg-footer__heading { font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: rgb(53 52 47); margin: 0 0 1rem; }
  .tg-footer__links { display: flex; flex-direction: column; gap: .6rem; font-size: 14px; }
  .tg-footer__links a, .tg-footer__contact a, .tg-footer__legal a { color: rgb(109 108 100); text-decoration: none; transition: color .15s ease; }
  .tg-footer__links a:hover, .tg-footer__contact a:hover, .tg-footer__legal a:hover,
  .tg-footer__links a:focus-visible, .tg-footer__contact a:focus-visible, .tg-footer__legal a:focus-visible { color: rgb(53 52 47); text-decoration: underline; text-underline-offset: 3px; }
  .tg-footer__social { color: rgb(53 52 47); margin-left: -6px; }
  .tg-footer__bottom { border-top: 1px solid rgb(238 236 232); padding: 1.5rem 0 2rem; display: flex; flex-direction: column; gap: 1.25rem; align-items: center; text-align: center; }
  .tg-footer__legal { display: flex; flex-wrap: wrap; justify-content: center; gap: .4rem 1.25rem; font-size: 12px; color: rgb(109 108 100); margin: 0; padding: 0; list-style: none; }
  .tg-footer__payments { display: flex; flex-wrap: wrap; justify-content: center; gap: .4rem; margin: 0; padding: 0; list-style: none; }
  .tg-footer__payments svg { height: 22px; width: auto; display: block; }
  @media (min-width: 768px) {
    .tg-footer__menus { grid-template-columns: repeat({{ footer_cols | default: 4 }}, minmax(0, 1fr)); }
  }
  @media (min-width: 1024px) {
    .tg-footer__signup { padding: 4rem 0; }
    .tg-footer__main { grid-template-columns: minmax(0, 1fr) minmax(0, 2.6fr); gap: 4rem; padding: 4.5rem 0 3.5rem; }
    .tg-footer__bottom { flex-direction: row; justify-content: space-between; text-align: left; }
    .tg-footer__legal { justify-content: flex-start; }
    .tg-footer__payments { justify-content: flex-end; }
  }
{%- endstyle -%}


<footer class="tg-footer" role="contentinfo">
  {%- if section.settings.show_newsletter -%}
    <div class="tg-footer__signup">
      {% render 'footer-newsletter', section: section %}
    </div>
  {%- endif -%}

  <div class="container">
    <div class="tg-footer__main">
      {%- comment -%} Brand column {%- endcomment -%}
      <div class="tg-footer__brand">
        {%- if section.settings.show_logo -%}
          <a href="{{ routes.root_url }}" class="tg-footer__logo" aria-label="{{ shop.name }}">
            {%- if section.settings.logo != blank -%}
              {{ section.settings.logo | image_url: width: 400 | image_tag: class: 'block h-auto w-full', loading: 'lazy', alt: shop.name }}
            {%- else -%}
              {% render 'footer-wordmark' %}
            {%- endif -%}
          </a>
        {%- endif -%}

        {%- if section.settings.brand_text != blank -%}
          <div class="tg-footer__tagline">{{ section.settings.brand_text }}</div>
        {%- endif -%}

        <ul class="tg-footer__contact" role="list">
          {%- if section.settings.email != blank -%}
            <li><a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></li>
          {%- endif -%}
          {%- if section.settings.phone != blank -%}
            <li><a href="tel:{{ section.settings.phone_link | default: section.settings.phone | remove: ' ' | remove: '(' | remove: ')' }}">{{ section.settings.phone }}</a></li>
          {%- endif -%}
        </ul>

        <div class="tg-footer__social">
          {% render 'social-links' %}
        </div>
      </div>

      {%- comment -%} Link columns {%- endcomment -%}
      <div class="tg-footer__menus">
        {%- for i in (1..4) -%}
          {%- liquid
            assign menu_key = 'menu_' | append: i
            assign heading_key = 'menu_' | append: i | append: '_heading'
            assign menu = section.settings[menu_key]
            assign heading = section.settings[heading_key] | default: menu.title
          -%}
          {%- if menu != blank -%}
            <div>
              <h2 class="tg-footer__heading">{{ heading }}</h2>
              <nav aria-label="{{ heading | escape }}">
                <ul class="tg-footer__links" role="list">
                  {%- for link in menu.links -%}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              </nav>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- comment -%} Legal bar {%- endcomment -%}
    <div class="tg-footer__bottom">
      <ul class="tg-footer__legal" role="list" aria-label="{{ 'sections.footer.legal_nav' | t }}">
        <li>
          {%- if section.settings.copyright_text != blank -%}
            {{ section.settings.copyright_text }}
          {%- else -%}
            &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}
          {%- endif -%}
        </li>
        {%- for link in section.settings.menu_legal.links -%}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {%- endfor -%}
      </ul>

      {%- if section.settings.show_payment_icons -%}
        {%- unless shop.enabled_payment_types == empty -%}
          <ul class="tg-footer__payments" role="list" aria-label="{{ 'sections.footer.payment_methods' | t }}">
            {%- for type in shop.enabled_payment_types -%}
              <li>{{ type | payment_type_svg_tag }}</li>
            {%- endfor -%}
          </ul>
        {%- endunless -%}
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "settings": [
    { "type": "header", "content": "Email sign-up" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show email sign-up", "default": true },
    { "type": "text", "id": "newsletter_heading", "label": "Heading", "default": "Get 10% off your first order" },
    { "type": "richtext", "id": "newsletter_text", "label": "Text", "default": "<p>Subscribe to learn about new products and offers, and get 10% off your first order.</p>" },
    { "type": "text", "id": "newsletter_button", "label": "Button label", "default": "Subscribe" },
    { "type": "text", "id": "newsletter_success", "label": "Success message", "default": "Thanks for subscribing!" },
    { "type": "richtext", "id": "newsletter_disclaimer", "label": "Small print", "default": "<p>By subscribing, you agree to receive marketing emails. Unsubscribe at any time.</p>" },
    { "type": "header", "content": "Brand" },
    { "type": "checkbox", "id": "show_logo", "label": "t:sections.footer.settings.show_logo.label", "default": true },
    { "type": "image_picker", "id": "logo", "label": "t:sections.footer.settings.logo.label", "info": "t:sections.footer.settings.logo.info" },
    { "type": "richtext", "id": "brand_text", "label": "Brand text", "default": "<p>Premium golf apparel, footwear and accessories from the brands you love.</p>" },
    { "type": "header", "content": "t:sections.footer.settings.contact_heading.content" },
    { "type": "text", "id": "email", "label": "t:sections.footer.settings.email.label", "default": "info@trendygolf.com" },
    { "type": "text", "id": "phone", "label": "t:sections.footer.settings.phone.label" },
    { "type": "text", "id": "phone_link", "label": "Phone number for tap-to-call", "info": "Digits only, e.g. +15619414653. Leave blank to use the phone text." },
    { "type": "header", "content": "t:sections.footer.settings.navigation_heading.content" },
    { "type": "link_list", "id": "menu_1", "label": "t:sections.footer.settings.menu_1.label", "default": "footer" },
    { "type": "text", "id": "menu_1_heading", "label": "t:sections.footer.settings.menu_1_heading.label", "info": "t:sections.footer.settings.menu_heading_info.info" },
    { "type": "link_list", "id": "menu_2", "label": "t:sections.footer.settings.menu_2.label" },
    { "type": "text", "id": "menu_2_heading", "label": "t:sections.footer.settings.menu_2_heading.label", "info": "t:sections.footer.settings.menu_heading_info.info" },
    { "type": "link_list", "id": "menu_3", "label": "t:sections.footer.settings.menu_3.label" },
    { "type": "text", "id": "menu_3_heading", "label": "t:sections.footer.settings.menu_3_heading.label", "info": "t:sections.footer.settings.menu_heading_info.info" },
    { "type": "link_list", "id": "menu_4", "label": "Menu column 4" },
    { "type": "text", "id": "menu_4_heading", "label": "Column 4 heading override", "info": "t:sections.footer.settings.menu_heading_info.info" },
    { "type": "header", "content": "t:sections.footer.settings.bottom_heading.content" },
    { "type": "link_list", "id": "menu_legal", "label": "t:sections.footer.settings.menu_legal.label" },
    { "type": "text", "id": "copyright_text", "label": "t:sections.footer.settings.copyright_text.label", "info": "t:sections.footer.settings.copyright_text.info" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "t:sections.footer.settings.show_payment_icons.label", "default": true }
  ]
}
{% endschema %}
