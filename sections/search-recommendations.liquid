{%- comment -%}
  Search recommendations — Rebuy-driven product carousel below the search results.
  Mirrors `sections/product-explore-more.liquid` and the cart-drawer pattern,
  but renders Rebuy results directly client-side from the Rebuy JSON response —
  no per-handle Section Rendering API waterfall. This drops total load time
  from ~1.5–3s (waterfall of 4–8 storefront re-renders) to a single Rebuy
  round-trip (~300–800ms). Fallback path still uses server-rendered
  `snippets/product-card.liquid` from a customizer-configured collection.

  Heading flips based on `data-has-results` on the upstream search-results section:
  no results → `heading_no_results`, results → `heading_with_results`.
{%- endcomment -%}

{%- liquid
  assign products_to_show = section.settings.products_to_show | default: 4
  assign fallback_collection = section.settings.fallback_collection
  assign heading_with_results = section.settings.heading_with_results | default: 'You may also like'
  assign heading_no_results = section.settings.heading_no_results | default: 'You might be interested in'
  assign has_fallback = false
  if fallback_collection != blank and fallback_collection.products_count > 0
    assign has_fallback = true
  endif
-%}

<script>
  window.searchRecommendationsConfig = {
    productsToShow: {{ products_to_show | json }},
    rebuyApiKey: {{ settings.rebuy_api_key | json }},
    rebuyRecommendationsId: {{ section.settings.rebuy_recommendations_id | json }},
    countryCode: {{ localization.country.iso_code | default: 'GB' | json }},
    rootUrl: {{ routes.root_url | json }},
    moneyFormat: {{ shop.money_format | json }},
    headingWithResults: {{ heading_with_results | json }},
    headingNoResults: {{ heading_no_results | json }}
  };
</script>

<section
  id="search-recommendations"
  class="mb-14"
  data-search-recommendations
  data-section-id="{{ section.id }}"
>
  <div class="container-wide">
    <h2
      class="mb-8 text-center font-serif text-3xl lg:text-4xl"
      data-search-recommendations-heading
    >
      {{- heading_with_results -}}
    </h2>

    {%- comment -%}
      Skeleton placeholder — visible whenever the grid is empty server-side
      and JS is about to populate from Rebuy. Hidden when a fallback collection
      already renders tiles into the grid (don't double up). Removed by JS once
      tiles render (Rebuy success, Rebuy fail, or no-Rebuy paths).
    {%- endcomment -%}
    <div
      class="grid grid-cols-2 gap-5 md:grid-cols-3 xl:grid-cols-4"
      data-search-recommendations-skeleton
      {% if has_fallback %}hidden{% endif %}
    >
      <div class="h-48 animate-pulse bg-black/10"></div>
      <div class="h-48 animate-pulse bg-black/10"></div>
      <div class="h-48 animate-pulse bg-black/10 hidden md:block"></div>
      <div class="h-48 animate-pulse bg-black/10 hidden md:block"></div>
    </div>

    <div
      class="grid grid-cols-2 gap-5 md:grid-cols-3 xl:grid-cols-4"
      data-search-recommendations-grid
    >
      {%- if has_fallback -%}
        {%- for product in fallback_collection.products limit: products_to_show -%}
          <div data-search-recommendations-tile>
            {%- render 'product-card', product: product -%}
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% javascript %}
  (function () {
    var root = document.querySelector('[data-search-recommendations]');
    if (!root) return;

    var cfg = window.searchRecommendationsConfig || {};
    var grid = root.querySelector('[data-search-recommendations-grid]');
    var skeleton = root.querySelector('[data-search-recommendations-skeleton]');
    var headingEl = root.querySelector('[data-search-recommendations-heading]');
    if (!grid || !headingEl) return;

    var rootUrl = cfg.rootUrl || '/';
    /* Tokens are split (`'{' + '{...'`) so the theme-check JS-block scanner
       doesn't read them as embedded Liquid output tags. They are still the
       canonical Shopify money_format placeholders at runtime. */
    var TOK_AMOUNT = '{' + '{amount}}';
    var TOK_AMOUNT_NO_DEC = '{' + '{amount_no_decimals}}';
    var TOK_AMOUNT_COMMA = '{' + '{amount_with_comma_separator}}';
    var TOK_AMOUNT_NO_DEC_COMMA = '{' + '{amount_no_decimals_with_comma_separator}}';
    var moneyFormat = cfg.moneyFormat || ('$' + TOK_AMOUNT);
    var productsToShow = parseInt(cfg.productsToShow, 10) || 4;

    function hideSkeleton() {
      /* Remove the skeleton from the DOM rather than setting `.hidden = true`.
         The skeleton carries `class="grid …"` (display: grid), which overrides
         the [hidden] UA rule (display: none) on the cascade (same specificity,
         later definition wins), so the attribute flip alone leaves the element
         painted above the real tiles. Mirrors `sections/product-explore-more.liquid`
         (`assets/theme.js:945`). Removal covers all four call sites — the early-
         return when Rebuy keys aren't set, plus the three `.then` / `.catch`
         branches (Rebuy success, Rebuy empty, Rebuy fail). */
      if (skeleton) skeleton.remove();
    }

    /* ---- Heading sync — read data-has-results from search-results section ---- */
    function syncHeading() {
      var resultsSection = document.querySelector('#search-section[data-has-results]');
      var hasResults = resultsSection ? resultsSection.getAttribute('data-has-results') === 'true' : true;
      var heading = hasResults ? cfg.headingWithResults : cfg.headingNoResults;
      if (heading) headingEl.textContent = heading;
    }
    syncHeading();

    /* Re-sync when the upstream search-results section swaps its DOM
       (filter/sort/pagination via Section Rendering API). One observe() call:
       a second call on the same target REPLACES the first per spec, so we have
       to merge the options. The search-results fetchSection callback now
       re-assigns section.dataset.hasResults from the newly-fetched doc, so
       attribute mutations fire here; subtree/childList covers the inner-grid
       innerHTML swap as a belt-and-braces fallback. */
    var resultsTarget = document.getElementById('search-section');
    if (resultsTarget && 'MutationObserver' in window) {
      var obs = new MutationObserver(function () { syncHeading(); });
      obs.observe(resultsTarget, {
        attributes: true,
        attributeFilter: ['data-has-results'],
        childList: true,
        subtree: true
      });
    }

    /* ---- Rebuy upgrade — only if both keys are set ---- */
    if (!cfg.rebuyApiKey || !cfg.rebuyRecommendationsId) {
      /* No Rebuy → fallback grid (or empty) is the final state. Drop the
         skeleton so it doesn't sit above the fallback tiles. */
      hideSkeleton();
      return;
    }

    fetchRebuyProducts(cfg)
      .then(function (products) {
        if (!products.length) {
          /* Rebuy returned nothing — keep server-rendered fallback (if any). */
          hideSkeleton();
          return;
        }
        grid.innerHTML = products.map(buildTile).join('');
        hideSkeleton();
      })
      .catch(function (err) {
        console.error('[SearchRecommendations] fetch failed', err);
        /* Keep server-rendered fallback in place; drop the skeleton. */
        hideSkeleton();
      });

    function fetchRebuyProducts(cfg) {
      var params = new URLSearchParams({
        key: cfg.rebuyApiKey,
        limit: String(productsToShow)
      });
      if (cfg.countryCode) params.set('country_code', cfg.countryCode);
      var url = 'https://rebuyengine.com/api/v1/custom/id/' +
        encodeURIComponent(cfg.rebuyRecommendationsId) + '?' + params.toString();

      return fetch(url, { headers: { Accept: 'application/json' } })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (json) {
          var data = json && Array.isArray(json.data) ? json.data : [];
          return data.filter(function (p) { return p && p.handle; }).slice(0, productsToShow);
        });
    }

    /* Build a product tile inline from a Rebuy product object. Mirrors
       `snippets/product-card.liquid` markup so Rebuy tiles read identically
       to server-rendered fallback tiles when they share the same grid.
       Rebuy variants[0].price / compare_at_price are strings in dollars;
       cart-drawer.js applies the same normalization. */
    function buildTile(p) {
      var handle = p.handle || '';
      var title = p.title || '';
      var vendor = p.vendor || '';
      var url = p.url || (rootUrl + 'products/' + handle);

      /* Image — Rebuy may expose .image (string or {src,alt}) or .images[] */
      var imgSrc = '';
      var imgAlt = title;
      if (typeof p.image === 'string') {
        imgSrc = p.image;
      } else if (p.image && p.image.src) {
        imgSrc = p.image.src;
        imgAlt = p.image.alt || title;
      } else if (p.images && p.images.length) {
        var first = p.images[0];
        imgSrc = typeof first === 'string' ? first : (first.src || '');
        imgAlt = (first && first.alt) || title;
      }

      /* Price — Rebuy: string dollars on variants[0]; Shopify shape: integer cents */
      var price = 0;
      var comparePrice = 0;
      if (p.variants && p.variants.length) {
        price = parseFloat(p.variants[0].price) || 0;
        comparePrice = parseFloat(p.variants[0].compare_at_price) || 0;
      } else {
        price = typeof p.price === 'number' ? p.price : parseFloat(p.price) || 0;
        comparePrice = typeof p.compare_at_price === 'number' ? p.compare_at_price : parseFloat(p.compare_at_price) || 0;
      }
      var isShopifyCents = typeof p.price === 'number' && p.price > 100;
      if (isShopifyCents) {
        price = price / 100;
        comparePrice = comparePrice / 100;
      }

      var priceHtml;
      if (comparePrice && comparePrice > price) {
        priceHtml = '<s class="text-taupe-700">' + formatMoney(comparePrice) + '</s> ' +
                    '<span class="font-semibold text-red-600">' + formatMoney(price) + '</span>';
      } else {
        priceHtml = '<span class="font-semibold">' + formatMoney(price) + '</span>';
      }

      var imgHtml = imgSrc ?
        '<img src="' + escAttr(imgSrc) + '" alt="' + escAttr(imgAlt) + '" class="absolute left-0 top-0 block size-full object-cover" loading="lazy" />' : '';

      var vendorHtml = vendor ?
        '<p class="mb-0 text-xs font-semibold tracking-wider text-taupe-700 md:text-sm">' + escHtml(vendor) + '</p>' : '';

      return '<div data-search-recommendations-tile>' +
        '<div class="h-full" data-product-card>' +
          '<div class="group relative mb-4 aspect-[9/12] overflow-hidden md:mb-5">' +
            '<a class="absolute left-0 top-0 z-[1] block size-full" href="' + escAttr(url) + '">' +
              imgHtml +
            '</a>' +
          '</div>' +
          '<div class="mb-2 flex flex-col gap-1 px-3 text-center">' +
            vendorHtml +
            '<p class="mb-0 text-base"><a href="' + escAttr(url) + '">' + escHtml(title) + '</a></p>' +
          '</div>' +
          '<div class="px-3 text-center">' +
            '<span class="mb-0 text-base">' + priceHtml + '</span>' +
          '</div>' +
        '</div>' +
      '</div>';
    }

    function formatMoney(amountInUnits) {
      var amount = parseFloat(amountInUnits);
      if (isNaN(amount)) amount = 0;
      var formatted = amount.toFixed(2);
      return moneyFormat
        .replace(TOK_AMOUNT, formatted)
        .replace(TOK_AMOUNT_NO_DEC, Math.round(amount).toString())
        .replace(TOK_AMOUNT_COMMA, formatted.replace('.', ','))
        .replace(TOK_AMOUNT_NO_DEC_COMMA, Math.round(amount).toString());
    }

    function escAttr(str) {
      return String(str == null ? '' : str)
        .replace(/&/g, '&amp;').replace(/"/g, '&quot;')
        .replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    function escHtml(str) {
      return String(str == null ? '' : str)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Search recommendations",
  "settings": [
    {
      "type": "paragraph",
      "content": "Rebuy API key is configured under Theme settings → Rebuy."
    },
    {
      "type": "text",
      "id": "rebuy_recommendations_id",
      "label": "Rebuy recommendations ID",
      "default": "151895",
      "info": "ID of the Rebuy Custom Data Source for search-page recommendations. UK and US carry different IDs."
    },
    {
      "type": "collection",
      "id": "fallback_collection",
      "label": "Fallback collection",
      "info": "Shown if Rebuy is unavailable."
    },
    {
      "type": "text",
      "id": "heading_with_results",
      "label": "Heading (when results exist)",
      "default": "You may also like"
    },
    {
      "type": "text",
      "id": "heading_no_results",
      "label": "Heading (when no results)",
      "default": "You might be interested in"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 4
    }
  ]
}
{% endschema %}
