{%- liquid
  assign title = section.settings.title
  assign max_products = section.settings.max_products | default: 8

  comment
    Item 2 — a tab is "populated" if it has a label AND either a hand-picked
    product list OR a collection override. When a collection is set it overrides
    the product list (see the render loop below). Liquid has no push, so tab
    indexes are built as a comma-delimited string.
  endcomment
  assign t1_has = false
  if section.settings.tab_1_label != blank
    if section.settings.tab_1_collection != blank
      assign t1_has = true
    elsif section.settings.tab_1_products.count > 0
      assign t1_has = true
    endif
  endif
  assign t2_has = false
  if section.settings.tab_2_label != blank
    if section.settings.tab_2_collection != blank
      assign t2_has = true
    elsif section.settings.tab_2_products.count > 0
      assign t2_has = true
    endif
  endif
  assign t3_has = false
  if section.settings.tab_3_label != blank
    if section.settings.tab_3_collection != blank
      assign t3_has = true
    elsif section.settings.tab_3_products.count > 0
      assign t3_has = true
    endif
  endif

  assign tab_indexes = ''
  if t1_has
    assign tab_indexes = tab_indexes | append: '1'
  endif
  if t2_has
    if tab_indexes != ''
      assign tab_indexes = tab_indexes | append: ','
    endif
    assign tab_indexes = tab_indexes | append: '2'
  endif
  if t3_has
    if tab_indexes != ''
      assign tab_indexes = tab_indexes | append: ','
    endif
    assign tab_indexes = tab_indexes | append: '3'
  endif

  assign tabs = tab_indexes | split: ','
  assign tab_count = tabs.size
-%}

{%- if tab_count > 0 -%}
  {{ 'splide.min.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'splide.min.js' | asset_url }}" defer></script>

  <section class="page-block relative lg:mb-20 mb-14 overflow-hidden" data-product-carousel-tabs id="product-carousel-tabs-{{ section.id }}">
    <div class="container-wide">

      {%- if title != blank -%}
        <div class="mb-6 text-center">
          <p><span class="font-serif"><span class="text-4xl lg:text-5xl">{{ title }}</span></span></p>
        </div>
      {%- endif -%}

      {%- if tab_count > 1 -%}
        <div class="mb-10 flex items-center justify-center" role="tablist" aria-orientation="horizontal">
          {%- for tab_index in tabs -%}
            {%- liquid
              case tab_index
                when '1'
                  assign tab_label = section.settings.tab_1_label
                when '2'
                  assign tab_label = section.settings.tab_2_label
                when '3'
                  assign tab_label = section.settings.tab_3_label
              endcase
            -%}
            <button
              type="button"
              class="border-b px-6 py-3 focus:outline-none lg:px-10 lg:py-4 lg:text-lg{% if forloop.first %} border-clubhouse-green-600 font-bold text-clubhouse-green-600{% else %} border-taupe-300{% endif %}"
              role="tab"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              data-tab-button="{{ forloop.index0 }}"
              tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
            >
              {{- tab_label -}}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- for tab_index in tabs -%}
        {%- liquid
          comment
            Item 2 — resolve this tab's source. A collection override wins over the
            hand-picked product list; when set we show its first `max_products`.
          endcomment
          case tab_index
            when '1'
              assign tab_products = section.settings.tab_1_products
              assign tab_collection = section.settings.tab_1_collection
            when '2'
              assign tab_products = section.settings.tab_2_products
              assign tab_collection = section.settings.tab_2_collection
            when '3'
              assign tab_products = section.settings.tab_3_products
              assign tab_collection = section.settings.tab_3_collection
          endcase
        -%}
        <div
          role="tabpanel"
          data-tab-panel="{{ forloop.index0 }}"
          {% unless forloop.first %}hidden{% endunless %}
        >
          <div class="relative" data-product-splide="{{ forloop.index0 }}">
            <div class="splide" data-splide-el>
              <div class="splide__track overflow-visible xl:overflow-hidden xl:py-1">
                <ul class="splide__list">
                  {%- if tab_collection != blank -%}
                    {%- for product in tab_collection.products limit: max_products -%}
                      <li class="splide__slide">
                        <div data-measure class="inline-block w-full h-full">
                          {%- render 'product-card', product: product -%}
                        </div>
                      </li>
                    {%- endfor -%}
                  {%- else -%}
                    {%- for product in tab_products -%}
                      <li class="splide__slide">
                        <div data-measure class="inline-block w-full h-full">
                          {%- render 'product-card', product: product -%}
                        </div>
                      </li>
                    {%- endfor -%}
                  {%- endif -%}
                </ul>
              </div>

              <div class="splide__arrows flex justify-center pt-6 md:absolute md:right-0 md:top-0 md:-translate-y-full md:pb-3 md:pt-0">
                <button class="splide__arrow splide__arrow--prev bg-taupe-300 p-3 transition-all duration-300 disabled:bg-transparent disabled:opacity-50" type="button">
                  {%- render 'icon', icon: 'chevron-left', size: 'size-6' -%}
                </button>
                <button class="splide__arrow splide__arrow--next bg-taupe-300 p-3 transition-all duration-300 disabled:bg-transparent disabled:opacity-50" type="button">
                  {%- render 'icon', icon: 'chevron-right', size: 'size-6' -%}
                </button>
              </div>
            </div>
          </div>

          {%- comment -%} Item 2 — "View all" collection link, centred below the row. Only when
            the toggle is on AND this tab has a collection set. {%- endcomment -%}
          {%- if section.settings.show_collection_links and tab_collection != blank -%}
            <div class="mt-8 flex justify-center lg:mt-10">
              <a
                href="{{ tab_collection.url }}"
                class="inline-flex items-center justify-center border border-taupe-900 px-10 py-3 text-sm uppercase tracking-wider transition-all hover:bg-taupe-900 hover:text-white"
              >
                {{ section.settings.collection_link_label | default: 'View all' }}
              </a>
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}

    </div>
  </section>

  <script>
    (function init() {
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
        return;
      }

      var section = document.getElementById('product-carousel-tabs-{{ section.id }}');
      if (!section) return;

      /* ── Tab switching ── */
      var tabButtons = section.querySelectorAll('[data-tab-button]');
      var tabPanels = section.querySelectorAll('[data-tab-panel]');
      var splideInstances = {};

      tabButtons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var idx = btn.getAttribute('data-tab-button');

          tabButtons.forEach(function (b) {
            var isActive = b.getAttribute('data-tab-button') === idx;
            b.setAttribute('aria-selected', isActive ? 'true' : 'false');
            b.setAttribute('tabindex', isActive ? '0' : '-1');

            /* Swap classes to match repo exactly */
            b.className = 'border-b px-6 py-3 focus:outline-none lg:px-10 lg:py-4 lg:text-lg'
              + (isActive
                ? ' border-clubhouse-green-600 font-bold text-clubhouse-green-600'
                : ' border-taupe-300');
          });

          tabPanels.forEach(function (panel) {
            if (panel.getAttribute('data-tab-panel') === idx) {
              panel.removeAttribute('hidden');
            } else {
              panel.setAttribute('hidden', '');
            }
          });

          /* Defer to next frames so iOS Safari can flush layout for the
             freshly-visible panel before Splide measures its track width. */
          requestAnimationFrame(function () {
            requestAnimationFrame(function () {
              initSplide(parseInt(idx, 10));
              if (splideInstances[idx]) {
                splideInstances[idx].refresh();
              }
            });
          });
        });
      });

      /* ── Splide initialisation ── */
      var splideOptions = {
        type: 'slide',
        perPage: 4,
        gap: 10,
        arrows: true,
        pagination: false,
        drag: true,
        breakpoints: {
          480: { perPage: 1, arrows: false, padding: { left: 0, right: '35%' } },
          768: { perPage: 2, arrows: false, padding: { left: 0, right: '20%' } },
          1280: { perPage: 3, padding: { left: 0, right: '10%' } }
        }
      };

      function initSplide(panelIndex) {
        if (splideInstances[panelIndex]) return;
        var wrapper = section.querySelector('[data-product-splide="' + panelIndex + '"]');
        if (!wrapper) return;
        var el = wrapper.querySelector('[data-splide-el]');
        if (!el || typeof Splide === 'undefined') return;
        splideInstances[panelIndex] = new Splide(el, splideOptions).mount();
      }

      /* Init first tab after layout settles (iOS-safe). */
      function initFirstTab() {
        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            initSplide(0);
          });
        });
      }
      if (typeof Splide === 'undefined') {
        /* Deferred splide.min.js may not be ready yet — wait for window load. */
        window.addEventListener('load', initFirstTab, { once: true });
      } else {
        initFirstTab();
      }

      /* ── Keyboard navigation for tabs (arrow keys) ── */
      var tabList = section.querySelector('[role="tablist"]');
      if (tabList) {
        tabList.addEventListener('keydown', function (e) {
          var idx = Array.prototype.indexOf.call(tabButtons, document.activeElement);
          if (idx < 0) return;

          var next = -1;
          if (e.key === 'ArrowRight') {
            next = (idx + 1) % tabButtons.length;
          } else if (e.key === 'ArrowLeft') {
            next = (idx - 1 + tabButtons.length) % tabButtons.length;
          }

          if (next >= 0) {
            e.preventDefault();
            tabButtons[next].focus();
            tabButtons[next].click();
          }
        });
      }
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.product_carousel_tabs.name",
  "tag": "section",
  "class": "product-carousel-tabs-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.product_carousel_tabs.settings.title.label",
      "default": "This Seasons Highlights"
    },
    {
      "type": "header",
      "content": "Collection links"
    },
    {
      "type": "checkbox",
      "id": "show_collection_links",
      "label": "Show \"View all\" collection button",
      "info": "Adds a button under a tab that links to that tab's collection. Only appears on tabs that have a Collection override set below.",
      "default": true
    },
    {
      "type": "text",
      "id": "collection_link_label",
      "label": "Button label",
      "default": "View all"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Max products per collection tab",
      "info": "How many products to show when a tab uses a Collection override.",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "header",
      "content": "Tab 1"
    },
    {
      "type": "text",
      "id": "tab_1_label",
      "label": "t:sections.product_carousel_tabs.settings.tab_1_label.label",
      "default": "Men"
    },
    {
      "type": "product_list",
      "id": "tab_1_products",
      "label": "t:sections.product_carousel_tabs.settings.tab_1_products.label",
      "limit": 25
    },
    {
      "type": "collection",
      "id": "tab_1_collection",
      "label": "Collection override",
      "info": "If set, overrides the products above and shows this collection's first products instead."
    },
    {
      "type": "header",
      "content": "Tab 2"
    },
    {
      "type": "text",
      "id": "tab_2_label",
      "label": "t:sections.product_carousel_tabs.settings.tab_2_label.label",
      "default": "Women"
    },
    {
      "type": "product_list",
      "id": "tab_2_products",
      "label": "t:sections.product_carousel_tabs.settings.tab_2_products.label",
      "limit": 25
    },
    {
      "type": "collection",
      "id": "tab_2_collection",
      "label": "Collection override",
      "info": "If set, overrides the products above and shows this collection's first products instead."
    },
    {
      "type": "header",
      "content": "Tab 3"
    },
    {
      "type": "text",
      "id": "tab_3_label",
      "label": "t:sections.product_carousel_tabs.settings.tab_3_label.label"
    },
    {
      "type": "product_list",
      "id": "tab_3_products",
      "label": "t:sections.product_carousel_tabs.settings.tab_3_products.label",
      "limit": 25
    },
    {
      "type": "collection",
      "id": "tab_3_collection",
      "label": "Collection override",
      "info": "If set, overrides the products above and shows this collection's first products instead."
    }
  ],
  "presets": [
    {
      "name": "t:sections.product_carousel_tabs.presets.name"
    }
  ]
}
{% endschema %}
