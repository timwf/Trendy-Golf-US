<header
  class="site-header z-10 h-[64px] lg:h-[74px]"
  data-header
>
  {%- comment -%} Search overlay — input row + predictive dropdown {%- endcomment -%}
  <div
    id="search-overlay"
    class="search-overlay absolute left-0 top-0 z-[2] w-full -translate-y-full overflow-hidden bg-white transition-transform duration-500"
    data-search-overlay
  >
    <form class="flex h-[64px] w-full items-center bg-white lg:h-[74px]" action="{{ routes.search_url }}" method="get" role="search">
      <input type="hidden" name="type" value="product">
      <div class="container flex items-center justify-between gap-5">
        <button type="submit" aria-label="{{ 'general.search.submit' | t }}">
          {% render 'icon', icon: 'magnifying-glass', size: 'size-6' %}
        </button>
        <input
          type="search"
          name="q"
          placeholder="{{ 'general.search.placeholder' | t }}"
          class="flex-1 text-xl focus:outline-none appearance-none bg-transparent"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="none"
          spellcheck="false"
          data-search-input
        >
        <button type="button" data-search-close aria-label="{{ 'general.accessibility.close' | t }}">
          {% render 'icon', icon: 'x-mark', size: 'size-6' %}
        </button>
      </div>
    </form>

    {%- comment -%} Predictive results panel — scrolls internally when open {%- endcomment -%}
    <div
      class="search-overlay__results hidden overflow-y-auto bg-white"
      data-search-results-panel
    >
      {% render 'predictive-search-dropdown', section: section %}
    </div>
  </div>

  <div
    class="header-inner transition-colors h-full duration-300"
    style="
      --header-solid-bg: {{ section.settings.solid_bg_color }};
      --header-solid-text: {{ section.settings.solid_text_color }};
      --header-transparent-text: {{ section.settings.transparent_text_color }};
    "
  >
    <div class="container-wide mx-auto flex h-full items-center justify-between">
    {%- comment -%} Left: hamburger + logo {%- endcomment -%}
    <div class="flex items-center gap-3">
      <button
        class="block xl:hidden"
        data-mobile-nav-open
        aria-label="{{ 'sections.header.mobile_menu_open' | t }}"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        {% render 'icon', icon: 'bars-3', size: 'size-6 md:size-8' %}
      </button>

      <a href="{{ routes.root_url }}" class="mr-4 block max-w-[160px] md:max-w-[260px]">
        {%- if section.settings.logo != blank -%}
          {%- assign has_light_logo = false -%}
          {%- if section.settings.logo_light != blank -%}
            {%- assign has_light_logo = true -%}
          {%- endif -%}
          {%- assign dark_logo_class = 'block w-full header-logo--dark' -%}
          {%- unless has_light_logo -%}
            {%- assign dark_logo_class = dark_logo_class | append: ' header-logo--force-white' -%}
          {%- endunless -%}
          {{ section.settings.logo | image_url: width: 520 | image_tag: class: dark_logo_class, loading: 'lazy', alt: shop.name }}
          {%- if has_light_logo -%}
            {{ section.settings.logo_light | image_url: width: 520 | image_tag: class: 'block w-full header-logo--light', loading: 'lazy', alt: shop.name }}
          {%- endif -%}
        {%- else -%}
          <span class="font-serif text-xl font-bold lg:text-2xl">{{ shop.name }}</span>
        {%- endif -%}
      </a>
    </div>

    {%- comment -%} Centre: desktop nav {%- endcomment -%}
    {%- assign main_menu = section.settings.menu -%}

    {%- comment -%}
      Item 3 — highlighted nav item(s). Build a |-delimited, lower-cased haystack of
      the customizer titles (comma-separated) so each top-level link can test itself
      with a single `contains`. Matched links get an inline colour (default red) that
      wins over the hover / mega-active nav rules. Used by both the desktop nav below
      and the mobile drawer further down.
    {%- endcomment -%}
    {%- assign hl_color = section.settings.highlight_nav_color -%}
    {%- assign hl_hay = '|' -%}
    {%- assign hl_tokens = section.settings.highlight_nav_title | default: '' | downcase | split: ',' -%}
    {%- for hl_t in hl_tokens -%}
      {%- assign hl_t = hl_t | strip -%}
      {%- if hl_t != '' -%}{%- assign hl_hay = hl_hay | append: hl_t | append: '|' -%}{%- endif -%}
    {%- endfor -%}

    <nav class="hidden items-center justify-between xl:block" aria-label="{{ 'sections.header.main_nav' | t }}">
      <ul class="flex">
        {%- for link in main_menu.links -%}
          {%- assign has_children = false -%}
          {%- if link.links.size > 0 -%}
            {%- assign has_children = true -%}
          {%- endif -%}

          {%- comment -%} Item 3 — does this top-level link match a highlighted title? {%- endcomment -%}
          {%- assign link_key = link.title | downcase | strip | prepend: '|' | append: '|' -%}
          {%- assign is_hl = false -%}
          {%- if hl_hay != '|' and hl_hay contains link_key -%}{%- assign is_hl = true -%}{%- endif -%}

          <li class="{% if has_children %}group/grandparent{% endif %}">
            <a
              href="{{ link.url }}"
              class="nav-link transition-colors inline-block border-b border-transparent px-5 py-6 {% if has_children %}group-hover/grandparent:border-clubhouse-green-600 group-hover/grandparent:text-clubhouse-green-600{% else %}hover:text-clubhouse-green-600{% endif %}"
              {% if is_hl and hl_color != blank %}style="color: {{ hl_color }};"{% endif %}
              {% if link.current %}aria-current="page"{% endif %}
            >
              {{ link.title }}
            </a>

            {%- if has_children -%}
              {% render 'mega-menu-dropdown', link: link, mega_blocks: section.blocks %}
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    {%- comment -%} Right: utility icons {%- endcomment -%}
    <div class="flex items-center gap-3 lg:gap-6">
      {%- if section.settings.other_region_url != blank -%}
        <div class="hidden lg:block">
          {% render 'flag-selector',
            current_region: section.settings.current_region,
            other_region_url: section.settings.other_region_url
          %}
        </div>
      {%- endif -%}

      <button
        data-search-open
        aria-label="{{ 'general.search.title' | t }}"
        class="hidden md:block"
      >
        {% render 'icon', icon: 'magnifying-glass', size: 'size-5' %}
      </button>

      <a href="/pages/swym-wishlist" aria-label="{{ 'sections.header.wishlist' | t }}" class="block">
        {% render 'icon', icon: 'heart', size: 'size-5' %}
      </a>

      <a href="{{ routes.account_url }}" aria-label="{{ 'sections.header.account' | t }}" class="block">
        {% render 'icon', icon: 'user', size: 'size-5' %}
      </a>

      <button
        data-cart-drawer-open
        aria-label="{{ 'sections.header.cart' | t }}"
        class="flex items-center gap-1"
      >
        {% render 'icon', icon: 'shopping-bag', size: 'size-5' %}
        <span data-cart-count>{{ cart.item_count }}</span>
      </button>
    </div>
    </div>
  </div>
</header>

{%- comment -%} Mobile nav drawer — mirrors `_reference/repo/app/components/sections/offcanvas.tsx` {%- endcomment -%}
<div
  class="fixed left-0 top-0 z-50 flex h-[100vh] w-[90%] flex-col overflow-hidden bg-white shadow-md transition-transform duration-500 md:max-w-lg xl:hidden -translate-x-full"
  aria-label="{{ 'sections.header.mobile_nav' | t }}"
  data-mobile-nav
  role="dialog"
  aria-modal="true"
>
  {%- comment -%} Top bar — three mutually exclusive left slots: idle / grandparent-back / parent-back {%- endcomment -%}
  <div class="h-[64px] w-full shrink-0 border-b border-taupe-300 lg:h-[74px]">
    <div class="flex h-full items-end items-center justify-between gap-2 px-6">
      {%- comment -%} Idle slot — region flag selector (see docs/header.md) {%- endcomment -%}
      <div data-mobile-topbar-idle class="flex-1">
        {%- if section.settings.other_region_url != blank -%}
          {% render 'flag-selector',
            current_region: section.settings.current_region,
            other_region_url: section.settings.other_region_url
          %}
        {%- endif -%}
      </div>

      {%- comment -%} Back to L1 (from an open L2) — JS adds `flex` to show {%- endcomment -%}
      <button
        type="button"
        class="text-clubhouse-green-600 flex-1 items-center hidden"
        data-mobile-back-grandparent
        aria-label="{{ 'general.accessibility.back' | t }}"
      >
        {% render 'icon', icon: 'chevron-left', size: 'mr-2 size-5 shrink-0' %}
        <span class="text-left text-lg font-bold" data-mobile-back-grandparent-label></span>
      </button>

      {%- comment -%} Back to L2 (from an open L3) — JS adds `flex` to show {%- endcomment -%}
      <button
        type="button"
        class="text-clubhouse-green-600 flex-1 items-center hidden"
        data-mobile-back-parent
        aria-label="{{ 'general.accessibility.back' | t }}"
      >
        {% render 'icon', icon: 'chevron-left', size: 'mr-2 size-5 shrink-0' %}
        <span class="text-left text-lg font-bold" data-mobile-back-parent-label></span>
      </button>

      <button
        type="button"
        aria-label="{{ 'general.accessibility.close' | t }}"
        class="shrink-0"
        data-mobile-nav-close
      >
        {% render 'icon', icon: 'x-mark', size: 'size-6' %}
      </button>
    </div>
  </div>

  {%- comment -%} Body {%- endcomment -%}
  <div class="relative h-full w-full flex-1 bg-white">
    <ul class="h-full w-full overflow-y-auto py-6 gap-6 flex flex-col">
      {%- for link in main_menu.links -%}
        {%- comment -%} Item 3 — highlight matched top-level link in the mobile drawer too {%- endcomment -%}
        {%- assign link_key = link.title | downcase | strip | prepend: '|' | append: '|' -%}
        {%- assign is_hl = false -%}
        {%- if hl_hay != '|' and hl_hay contains link_key -%}{%- assign is_hl = true -%}{%- endif -%}
        <li>
          <div class="flex justify-between w-full px-6">
            <a href="{{ link.url }}" {% if is_hl and hl_color != blank %}style="color: {{ hl_color }};"{% endif %} {% if link.current %}aria-current="page"{% endif %}>
              <span><span>{{ link.title }}</span></span>
            </a>
            {%- if link.links.size > 0 -%}
              <button
                type="button"
                aria-label="{{ 'sections.header.submenu_open' | t: title: link.title }}"
                class="flex flex-1 shrink-0 items-center justify-end"
                data-mobile-open-grandparent="{{ link.title | escape }}"
              >
                {% render 'icon', icon: 'chevron-right', size: 'ml-3 size-6' %}
              </button>
            {%- endif -%}
          </div>

          {%- if link.links.size > 0 -%}
            {%- comment -%} L2 panel — nested inside the L1 <li> {%- endcomment -%}
            <div
              class="absolute right-0 top-0 h-full w-[100%] overflow-hidden bg-white transition-transform duration-500 translate-x-full"
              data-mobile-panel-grandparent="{{ link.title | escape }}"
            >
              <ul class="h-full w-full overflow-y-auto py-6 gap-6 flex flex-col">
                {%- for child_link in link.links -%}
                  <li>
                    <div class="flex justify-between w-full px-6">
                      <a href="{{ child_link.url }}" {% if child_link.current %}aria-current="page"{% endif %}>
                        <span><span>{{ child_link.title }}</span></span>
                      </a>
                      {%- if child_link.links.size > 0 -%}
                        <button
                          type="button"
                          class="flex flex-1 shrink-0 items-center justify-end"
                          aria-label="{{ 'sections.header.submenu_open' | t: title: child_link.title }}"
                          data-mobile-open-parent="{{ child_link.title | escape }}"
                        >
                          {% render 'icon', icon: 'chevron-right', size: 'ml-3 size-6' %}
                        </button>
                      {%- endif -%}
                    </div>

                    {%- if child_link.links.size > 0 -%}
                      {%- comment -%} L3 panel — nested inside the L2 <li> {%- endcomment -%}
                      <div
                        class="absolute right-0 top-0 h-full w-[100%] overflow-hidden bg-white transition-transform duration-500 translate-x-full"
                        data-mobile-panel-parent="{{ child_link.title | escape }}"
                      >
                        <ul class="h-full w-full overflow-y-auto py-6 gap-6 flex flex-col">
                          {%- for grandchild_link in child_link.links -%}
                            <li>
                              <div class="w-full px-6">
                                <a href="{{ grandchild_link.url }}" {% if grandchild_link.current %}aria-current="page"{% endif %}>
                                  <span><span>{{ grandchild_link.title }}</span></span>
                                </a>
                              </div>
                            </li>
                          {%- endfor -%}
                        </ul>
                      </div>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{%- comment -%} Mobile nav overlay {%- endcomment -%}
<div
  class="fixed left-0 top-0 z-[49] h-full w-full overflow-hidden bg-black/50 transition-opacity duration-500 ease-in-out xl:hidden opacity-0 pointer-events-none"
  data-mobile-nav-overlay
></div>

{%- comment -%} Predictive search config — read by the inline JS below {%- endcomment -%}
<script>
  window.predictiveSearchConfig = {
    showProducts: {{ section.settings.predictive_show_products | json }},
    showArticles: {{ section.settings.predictive_show_articles | json }},
    articlesLimit: {{ section.settings.predictive_articles_limit | default: 4 | json }},
    searchUrl: {{ routes.search_url | json }},
    predictiveSearchUrl: {{ routes.predictive_search_url | json }},
    rootUrl: {{ routes.root_url | json }},
    viewAllLabel: {{ 'general.search.view_all_results' | t: query: '__QUERY__' | json }}
  };
</script>

<script>
  (function () {
    var cfg = window.predictiveSearchConfig || {};
    var overlay = document.querySelector('[data-search-overlay]');
    if (!overlay) return;
    var input = overlay.querySelector('[data-search-input]');
    var panel = overlay.querySelector('[data-search-results-panel]');
    var dropdown = overlay.querySelector('[data-predictive-dropdown]');
    if (!input || !panel || !dropdown) return;

    var productsCol = dropdown.querySelector('[data-predictive-col-products]');
    var articlesCol = dropdown.querySelector('[data-predictive-col-articles]');
    var productsGrid = dropdown.querySelector('[data-predictive-products]');
    var articlesList = dropdown.querySelector('[data-predictive-articles]');
    var emptyEl = dropdown.querySelector('[data-predictive-empty]');
    var loadingEl = dropdown.querySelector('[data-predictive-loading]');
    var resultsEl = dropdown.querySelector('[data-predictive-results]');
    var footerEl = dropdown.querySelector('[data-predictive-footer]');
    var viewAllLink = dropdown.querySelector('[data-predictive-view-all]');

    var debounceTimer = null;
    var inflightAbort = null;

    /* Responsive column ramp — single row of cards across breakpoints.
     * Must mirror the Tailwind grid classes in snippets/predictive-search-dropdown.liquid:
     *   grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6
     * Rendered card count = column count so the grid never wraps. */
    var mqMd = window.matchMedia('(min-width: 768px)');
    var mqLg = window.matchMedia('(min-width: 1024px)');
    var mqXl = window.matchMedia('(min-width: 1280px)');

    function escAttr(str) {
      return String(str == null ? '' : str)
        .replace(/&/g, '&amp;').replace(/"/g, '&quot;')
        .replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    function escHtml(str) {
      return String(str == null ? '' : str)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    /* Shopify's `t` filter HTML-escapes embedded characters (e.g. " → &quot;).
     * The translated label is later set as textContent — so decode entities first. */
    function decodeEntities(str) {
      var tmp = document.createElement('textarea');
      tmp.innerHTML = String(str == null ? '' : str);
      return tmp.value;
    }

    function getEnabledTypes() {
      var types = [];
      if (cfg.showProducts) types.push('product');
      if (cfg.showArticles) types.push('article');
      return types;
    }

    function getProductLimit() {
      if (mqXl.matches) return 6;
      if (mqLg.matches) return 5;
      if (mqMd.matches) return 4;
      return 3;
    }

    function getLimitForType(t) {
      if (t === 'product') return getProductLimit();
      if (t === 'article') return cfg.articlesLimit;
      return 4;
    }

    function showDropdown() {
      dropdown.hidden = false;
      dropdown.classList.remove('hidden');
      panel.classList.remove('hidden');
      overlay.setAttribute('data-predictive-open', 'true');
    }

    function hideDropdown() {
      dropdown.hidden = true;
      dropdown.classList.add('hidden');
      panel.classList.add('hidden');
      overlay.removeAttribute('data-predictive-open');
    }

    function showLoading() {
      loadingEl.classList.remove('hidden');
      resultsEl.classList.add('hidden');
      footerEl.classList.add('hidden');
      emptyEl.classList.add('hidden');
    }

    function showEmpty() {
      loadingEl.classList.add('hidden');
      resultsEl.classList.add('hidden');
      footerEl.classList.add('hidden');
      emptyEl.classList.remove('hidden');
    }

    function showResults() {
      loadingEl.classList.add('hidden');
      resultsEl.classList.remove('hidden');
      footerEl.classList.remove('hidden');
      emptyEl.classList.add('hidden');
    }

    function renderArticleRows(articles) {
      if (!articlesList) return;
      articlesList.innerHTML = articles.map(function (a) {
        var url = a.url || '#';
        var title = escHtml(a.title || '');
        var summary = escHtml((a.summary_html || a.summary || '').replace(/<[^>]+>/g, '').slice(0, 90));
        var imgSrc = (a.image && (typeof a.image === 'string' ? a.image : a.image.src)) || '';
        var imgHtml = imgSrc ?
          '<img src="' + escAttr(imgSrc) + '" alt="' + escAttr(title) + '" class="size-12 shrink-0 object-cover" loading="lazy" />' : '';
        return '<li>' +
          '<a class="flex items-start gap-3 hover:text-clubhouse-green-600" href="' + escAttr(url) + '">' +
            imgHtml +
            '<span class="flex flex-col">' +
              '<span class="mb-0 text-sm font-semibold">' + title + '</span>' +
              (summary ? '<span class="mb-0 text-xs text-taupe-700">' + summary + '</span>' : '') +
            '</span>' +
          '</a>' +
        '</li>';
      }).join('');
    }

    function fetchProductCards(products, signal) {
      if (!productsGrid) return Promise.resolve([]);
      var rootUrl = cfg.rootUrl || '/';
      return Promise.all(products.map(function (prod) {
        var handle = prod.handle;
        if (!handle) return Promise.resolve(null);
        var url = rootUrl + 'products/' + encodeURIComponent(handle) + '?section_id=product-card-renderer';
        return fetch(url, { credentials: 'same-origin', signal: signal })
          .then(function (r) { return r.ok ? r.text() : ''; })
          .then(function (html) {
            if (!html) return null;
            var tmp = document.createElement('div');
            tmp.innerHTML = html.trim();
            var wrapper = tmp.querySelector('#shopify-section-product-card-renderer') || tmp.firstElementChild;
            return wrapper ? wrapper.innerHTML : null;
          })
          .catch(function () { return null; });
      })).then(function (results) { return results.filter(Boolean); });
    }

    function clearResults() {
      if (productsGrid) productsGrid.innerHTML = '';
      if (articlesList) articlesList.innerHTML = '';
      if (productsCol) productsCol.hidden = true;
      if (articlesCol) articlesCol.hidden = true;
    }

    function performSearch(query) {
      var types = getEnabledTypes();
      if (!types.length) { showEmpty(); return; }

      if (inflightAbort) { try { inflightAbort.abort(); } catch (e) {} }
      var controller = ('AbortController' in window) ? new AbortController() : null;
      inflightAbort = controller;

      clearResults();
      showLoading();

      var params = new URLSearchParams();
      params.set('q', query);
      params.set('resources[type]', types.join(','));
      params.set('resources[limit]', String(Math.max(
        getProductLimit(), cfg.articlesLimit
      )));
      params.set('resources[options][unavailable_products]', 'hide');

      var url = (cfg.predictiveSearchUrl || '/search/suggest') + '.json?' + params.toString();

      fetch(url, {
        credentials: 'same-origin',
        headers: { 'Accept': 'application/json' },
        signal: controller ? controller.signal : undefined
      })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (json) {
          if (!json) { showEmpty(); return; }
          var resources = (json.resources && json.resources.results) || {};
          var products = (resources.products || []).slice(0, getLimitForType('product'));
          var articles = (resources.articles || []).slice(0, getLimitForType('article'));

          var anything = false;

          if (cfg.showProducts && products.length) {
            anything = true;
            productsCol.hidden = false;
            return fetchProductCards(products, controller ? controller.signal : undefined).then(function (cards) {
              productsGrid.innerHTML = cards.map(function (html) {
                return '<div>' + html + '</div>';
              }).join('');
              return { articles: articles };
            });
          }
          return { articles: articles };
        })
        .then(function (rest) {
          if (!rest) return;
          if (cfg.showArticles && rest.articles && rest.articles.length) {
            articlesCol.hidden = false;
            renderArticleRows(rest.articles);
          }

          var anyVisible = (productsCol && !productsCol.hidden) ||
                           (articlesCol && !articlesCol.hidden);
          if (anyVisible) {
            showResults();
            var encoded = encodeURIComponent(input.value);
            var href = (cfg.searchUrl || '/search') + '?q=' + encoded + '&type=product';
            viewAllLink.setAttribute('href', href);
            var label = decodeEntities(cfg.viewAllLabel || 'View all results for "__QUERY__"');
            viewAllLink.textContent = label.replace('__QUERY__', input.value);
          } else {
            showEmpty();
          }
        })
        .catch(function (err) {
          if (err && err.name === 'AbortError') return;
          showEmpty();
        });
    }

    input.addEventListener('input', function () {
      var q = (input.value || '').trim();
      if (debounceTimer) clearTimeout(debounceTimer);
      if (!q) {
        if (inflightAbort) { try { inflightAbort.abort(); } catch (e) {} }
        clearResults();
        hideDropdown();
        return;
      }
      showDropdown();
      debounceTimer = setTimeout(function () { performSearch(q); }, 200);
    });

    /* Close dropdown when overlay closes (existing closeSearch in theme.js fires on click/esc) */
    document.addEventListener('click', function (e) {
      if (e.target.closest('[data-search-close]')) {
        if (inflightAbort) { try { inflightAbort.abort(); } catch (e2) {} }
        clearResults();
        hideDropdown();
        input.value = '';
      }
    });

    /* Outside-click closes dropdown */
    document.addEventListener('click', function (e) {
      if (!overlay.contains(e.target) && !e.target.closest('[data-search-open]')) {
        if (!dropdown.hidden) {
          clearResults();
          hideDropdown();
        }
      }
    });

    /* Recompute product limit when viewport crosses any of the breakpoints
     * the grid ramp uses (md / lg / xl). The rendered card count is derived
     * from viewport, so a crossing changes the result set and the grid would
     * either wrap or under-fill without a re-fetch. */
    function onBreakpointChange() {
      var q = (input.value || '').trim();
      if (q && !dropdown.hidden) performSearch(q);
    }
    [mqMd, mqLg, mqXl].forEach(function (mq) {
      if (mq.addEventListener) {
        mq.addEventListener('change', onBreakpointChange);
      } else if (mq.addListener) {
        /* Safari < 14 legacy API */
        mq.addListener(onBreakpointChange);
      }
    });
  })();
</script>

<script>
  /* Sticky header group — the countdown bar + header stick to the top as one
   * stack; scrolling down slides the stack away, scrolling up brings it back.
   * Offsets are measured at runtime so the stack self-adjusts whichever
   * sections are present (countdown bar live/expired, announcement bar
   * enabled/disabled). */
  (function () {
    var groups = Array.prototype.slice.call(document.querySelectorAll('.shopify-section-group-header-group'));
    if (!groups.length) return;

    var stackH = 0;

    function layout() {
      var top = 0;
      var z = 30;
      groups.forEach(function (g) {
        var h = g.offsetHeight;
        g.style.position = 'sticky';
        g.style.zIndex = z--;
        if (!h) { g.style.top = '0px'; return; }
        g.style.top = top + 'px';
        g.style.setProperty('--sticky-top', top + 'px');
        top += h;
      });
      stackH = top;
    }

    layout();
    window.addEventListener('resize', layout, { passive: true });

    var lastY = window.scrollY;
    function setHidden(hidden) {
      groups.forEach(function (g) { g.classList.toggle('header-group--hidden', hidden); });
    }
    window.addEventListener('scroll', function () {
      var y = window.scrollY;
      if (y <= stackH) {
        setHidden(false);
      } else if (y > lastY + 2) {
        setHidden(true);
      } else if (y < lastY - 2) {
        setHidden(false);
      }
      lastY = y;
    }, { passive: true });
  })();
</script>

{% stylesheet %}
  /* Sticky header group — each section slides up by its own height plus its
   * offset within the stack, so the whole group hides/reveals as one unit. */
  .shopify-section-group-header-group { transition: transform 300ms ease; }
  .header-group--hidden { transform: translateY(calc(-100% - var(--sticky-top, 0px))); }

  /* iOS Safari paints `<input type="search">` with a tinted rounded background
   * and a native clear button. Tailwind's `appearance-none` strips the rounded
   * chrome on the input itself; this rule strips the WebKit pseudo-element
   * clear button so the [data-search-close] x-icon stays the only clear UI. */
  [data-search-input]::-webkit-search-cancel-button,
  [data-search-input]::-webkit-search-decoration {
    -webkit-appearance: none;
    display: none;
  }

  /* Search overlay — input row by default, expands when predictive panel opens */
  .search-overlay { max-height: 74px; transition: max-height 300ms cubic-bezier(0.4, 0, 0.2, 1), transform 500ms; }
  @media (max-width: 767px) {
    .search-overlay { max-height: 100dvh; height: 100dvh; }
    .search-overlay .search-overlay__results { max-height: calc(100dvh - 64px); }
  }
  @media (min-width: 768px) {
    .search-overlay[data-predictive-open="true"] { max-height: 80vh; }
    .search-overlay__results { max-height: calc(80vh - 74px); }
  }

  /* Default: relative position, solid colors */
  .site-header { position: relative; }
  .site-header .header-inner {
    background-color: var(--header-solid-bg);
    color: var(--header-solid-text);
  }
  .site-header .header-logo--light { display: none; }

  /* Item 1 — hero pages now render the header FULLY SOLID from the top.
     The old transparent/white-logo overlay state dropped the logo + menu on
     light banner slides, so hero pages fall through to the default solid bar
     above (cream bg, dark nav text, green TG logo) — identical to every other
     page. The [data-hero] hook is kept so this is a one-block revert if the
     transparent hero header is ever wanted back. */

  /* Mega-active nav links match solid text colour */
  .site-header.header--mega-active .nav-link {
    color: var(--header-solid-text);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.header.name",
  "class": "header-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:sections.header.settings.logo.label"
    },
    {
      "type": "image_picker",
      "id": "logo_light",
      "label": "Light logo (transparent header)",
      "info": "White/light version shown on transparent header pages. Falls back to main logo if not set."
    },
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "t:sections.header.settings.menu.label"
    },
    {
      "type": "header",
      "content": "t:sections.header.settings.header_colors.content"
    },
    {
      "type": "color",
      "id": "transparent_text_color",
      "default": "#ffffff",
      "label": "t:sections.header.settings.transparent_text_color.label"
    },
    {
      "type": "color",
      "id": "solid_bg_color",
      "default": "#f6f5f2",
      "label": "t:sections.header.settings.solid_bg_color.label"
    },
    {
      "type": "color",
      "id": "solid_text_color",
      "default": "#35342f",
      "label": "t:sections.header.settings.solid_text_color.label"
    },
    {
      "type": "header",
      "content": "Highlighted nav item"
    },
    {
      "type": "text",
      "id": "highlight_nav_title",
      "label": "Menu item to highlight",
      "info": "Type the exact top-level menu item to recolour, e.g. Summer Sale. Separate several with commas. Leave blank for none."
    },
    {
      "type": "color",
      "id": "highlight_nav_color",
      "default": "#cc0000",
      "label": "Highlight colour"
    },
    {
      "type": "header",
      "content": "t:sections.header.settings.region.content"
    },
    {
      "type": "select",
      "id": "current_region",
      "default": "US",
      "label": "t:sections.header.settings.current_region.label",
      "info": "t:sections.header.settings.current_region.info",
      "options": [
        { "value": "UK", "label": "t:sections.header.settings.current_region.options.uk" },
        { "value": "US", "label": "t:sections.header.settings.current_region.options.us" }
      ]
    },
    {
      "type": "url",
      "id": "other_region_url",
      "label": "t:sections.header.settings.other_region_url.label",
      "info": "t:sections.header.settings.other_region_url.info"
    },
    {
      "type": "header",
      "content": "Predictive search"
    },
    {
      "type": "checkbox",
      "id": "predictive_show_products",
      "label": "Show products",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "predictive_show_articles",
      "label": "Show magazine articles",
      "default": false
    },
    {
      "type": "range",
      "id": "predictive_articles_limit",
      "label": "Articles limit",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "visible_if": "{{ section.settings.predictive_show_articles }}"
    }
  ],
  "blocks": [
    {
      "type": "mega_menu_image",
      "name": "t:sections.header.blocks.mega_menu_image.name",
      "limit": 10,
      "settings": [
        {
          "type": "text",
          "id": "menu_item_title",
          "label": "t:sections.header.blocks.mega_menu_image.settings.menu_item_title.label",
          "info": "t:sections.header.blocks.mega_menu_image.settings.menu_item_title.info"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.header.blocks.mega_menu_image.settings.image.label",
          "info": "Recommended: 1600×1600px (1:1). Image is cover-cropped to the slot, so a square source covers every aspect the slot may render at."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.header.blocks.mega_menu_image.settings.heading.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.header.blocks.mega_menu_image.settings.link.label"
        },
        {
          "type": "text",
          "id": "link_text",
          "default": "Shop now",
          "label": "t:sections.header.blocks.mega_menu_image.settings.link_text.label"
        }
      ]
    }
  ]
