{%- liquid
  # Countdown bar: renders only while the target date/time (entered as
  # "YYYY-MM-DD HH:MM", interpreted in the STORE's timezone) is in the
  # future. Liquid resolves it to epoch seconds so the client-side timer
  # is timezone-proof; JS hides the whole bar the moment it hits zero.
  assign countdown_armed = false
  assign target_ts = ''
  if section.settings.end_date != blank
    assign target_ts = section.settings.end_date | date: '%s'
    assign now_ts = 'now' | date: '%s' | plus: 0
    assign target_ts_num = target_ts | plus: 0
    if target_ts_num > now_ts
      assign countdown_armed = true
    endif
  endif
-%}

{%- if countdown_armed -%}
  <div
    class="countdown-bar relative z-20 flex flex-wrap items-center justify-center gap-1 px-4 py-2 text-center text-xs font-medium tracking-wide md:text-sm"
    style="background-color: {{ section.settings.background_color }}; color: {{ section.settings.text_color }};"
    role="region"
    aria-label="Countdown"
    data-countdown-bar
    data-countdown-ts="{{ target_ts }}"
    data-show-days="{{ section.settings.show_days }}"
    data-show-hours="{{ section.settings.show_hours }}"
    data-show-minutes="{{ section.settings.show_minutes }}"
    data-show-seconds="{{ section.settings.show_seconds }}"
  >
    {%- if section.settings.text != blank -%}
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" class="hover:underline">
          {{ section.settings.text }}
          {%- if section.settings.link_text != blank -%}
            <span class="ml-1 underline">{{ section.settings.link_text }}</span>
          {%- endif -%}
        </a>
      {%- else -%}
        <p class="mb-0">{{ section.settings.text }}</p>
      {%- endif -%}
    {%- endif -%}

    <span class="inline-flex items-center gap-1 whitespace-nowrap font-semibold" style="font-variant-numeric: tabular-nums;" hidden data-cd-wrap>
      {%- if section.settings.show_days -%}
        <span><span data-cd-days>00</span>d</span>
      {%- endif -%}
      {%- if section.settings.show_hours -%}
        <span><span data-cd-hours>00</span>h</span>
      {%- endif -%}
      {%- if section.settings.show_minutes -%}
        <span><span data-cd-mins>00</span>m</span>
      {%- endif -%}
      {%- if section.settings.show_seconds -%}
        <span><span data-cd-secs>00</span>s</span>
      {%- endif -%}
    </span>
  </div>

  <script>
    (function() {
      var el = document.querySelector('[data-countdown-bar]');
      if (!el) return;
      var target = parseInt(el.getAttribute('data-countdown-ts'), 10) * 1000;
      if (!target) { el.remove(); return; }

      var showDays = el.getAttribute('data-show-days') === 'true';
      var showHours = el.getAttribute('data-show-hours') === 'true';
      var showMins = el.getAttribute('data-show-minutes') === 'true';
      var wrap = el.querySelector('[data-cd-wrap]');
      var elDays = el.querySelector('[data-cd-days]');
      var elHours = el.querySelector('[data-cd-hours]');
      var elMins = el.querySelector('[data-cd-mins]');
      var elSecs = el.querySelector('[data-cd-secs]');
      var timer = null;

      function pad(n) { return String(n).padStart(2, '0'); }

      function tick() {
        var msLeft = target - Date.now();
        if (msLeft <= 0) {
          el.remove();
          if (timer) clearInterval(timer);
          window.dispatchEvent(new Event('resize'));
          return;
        }
        var totalSec = Math.floor(msLeft / 1000);
        // Hidden units roll into the next visible one so the timer never lies:
        // no days -> hours accumulate past 23; no hours -> minutes accumulate; etc.
        var days = Math.floor(totalSec / 86400);
        var hours = showDays ? Math.floor((totalSec % 86400) / 3600) : Math.floor(totalSec / 3600);
        var mins = showHours ? Math.floor((totalSec % 3600) / 60) : Math.floor(totalSec / 60);
        var secs = showMins ? totalSec % 60 : totalSec;

        if (elDays) elDays.textContent = pad(days);
        if (elHours) elHours.textContent = pad(hours);
        if (elMins) elMins.textContent = pad(mins);
        if (elSecs) elSecs.textContent = pad(secs);
        if (wrap) wrap.hidden = false;
      }

      tick();
      timer = setInterval(tick, 1000);
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Countdown bar",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows a bar with a live countdown until the end date passes, then disappears automatically. Nothing shows if the date is blank, invalid, or already in the past."
    },
    {
      "type": "text",
      "id": "end_date",
      "label": "Count down to",
      "info": "Format: YYYY-MM-DD HH:MM (24-hour clock, store timezone) — e.g. 2026-07-31 23:59"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Sale ends in"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link text"
    },
    {
      "type": "header",
      "content": "Timer"
    },
    {
      "type": "checkbox",
      "id": "show_days",
      "label": "Show days",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_hours",
      "label": "Show hours",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_minutes",
      "label": "Show minutes",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_seconds",
      "label": "Show seconds",
      "default": true
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#35342f"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Countdown bar"
    }
  ]
}
{% endschema %}
