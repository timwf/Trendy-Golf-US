{% doc %}
  @prompt
    Subscribe to our emails & get 10% off your first order. Footer data colletion box
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% capture newsletter_form_id %}NewsletterForm-{{ ai_gen_id }}{% endcapture %}

{% style %}
  .ai-newsletter-{{ ai_gen_id }} {
    display: block;
    box-sizing: border-box;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: 28px;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
    font-family: {{ settings.font_body.family }}, sans-serif;
  }
  .ai-newsletter-{{ ai_gen_id }}__inner { max-width: 520px; margin: 0 auto; }
  .ai-newsletter-{{ ai_gen_id }}__heading {
    margin: 0 0 8px;
    color: {{ block.settings.text_color }};
    font-family: {{ settings.font_heading.family }}, serif;
    font-size: 25px;
    line-height: 1.2;
  }
  .ai-newsletter-{{ ai_gen_id }}__copy { margin: 0 0 18px; line-height: 1.5; }
  .ai-newsletter-{{ ai_gen_id }}__form { display: flex; gap: 8px; }
  .ai-newsletter-{{ ai_gen_id }}__input {
    box-sizing: border-box;
    min-width: 0;
    flex: 1;
    padding: 12px 14px;
    border: 1px solid {{ block.settings.text_color }};
    border-radius: 2px;
    background: #fff;
    color: #222;
    font: inherit;
  }
  .ai-newsletter-{{ ai_gen_id }}__button {
    padding: 12px 18px;
    border: 1px solid {{ block.settings.button_color }};
    border-radius: 2px;
    background: {{ block.settings.button_color }};
    color: #fff;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .ai-newsletter-{{ ai_gen_id }}__button:hover { filter: brightness(.88); }
  .ai-newsletter-{{ ai_gen_id }}__input:focus-visible,
  .ai-newsletter-{{ ai_gen_id }}__button:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  .ai-newsletter-{{ ai_gen_id }}__message { margin: 12px 0 0; }
  @media screen and (max-width: 520px) {
    .ai-newsletter-{{ ai_gen_id }} { padding: 22px 16px; }
    .ai-newsletter-{{ ai_gen_id }}__form { flex-direction: column; }
    .ai-newsletter-{{ ai_gen_id }}__button { width: 100%; }
  }
{% endstyle %}

<div class="ai-newsletter-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-newsletter-{{ ai_gen_id }}__inner">
    {% if block.settings.heading != blank %}<h2 class="ai-newsletter-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
    {% if block.settings.description != blank %}<p class="ai-newsletter-{{ ai_gen_id }}__copy">{{ block.settings.description | escape }}</p>{% endif %}
    {% form 'customer', id: newsletter_form_id %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="ai-newsletter-{{ ai_gen_id }}__form">
        <label class="visually-hidden" for="NewsletterEmail-{{ ai_gen_id }}">{{ block.settings.email_label | escape }}</label>
        <input
          id="NewsletterEmail-{{ ai_gen_id }}"
          class="ai-newsletter-{{ ai_gen_id }}__input"
          type="email"
          name="contact[email]"
          value="{{ form.email | escape }}"
          placeholder="{{ block.settings.email_label | escape }}"
          autocomplete="email"
          autocorrect="off"
          autocapitalize="off"
          required
          aria-required="true"
          {% if form.errors %}aria-invalid="true" aria-describedby="NewsletterError-{{ ai_gen_id }}"{% endif %}
          {% if form.posted_successfully? %}aria-describedby="NewsletterSuccess-{{ ai_gen_id }}"{% endif %}
        >
        <button class="ai-newsletter-{{ ai_gen_id }}__button" type="submit">{{ block.settings.button_label | escape }}</button>
      </div>
      {% if form.errors %}<p id="NewsletterError-{{ ai_gen_id }}" class="ai-newsletter-{{ ai_gen_id }}__message" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{% endif %}
      {% if form.posted_successfully? %}<p id="NewsletterSuccess-{{ ai_gen_id }}" class="ai-newsletter-{{ ai_gen_id }}__message" role="status">{{ block.settings.success_message | escape }}</p>{% endif %}
    {% endform %}
  </div>
</div>

{% schema %}
{
  "name": "Footer newsletter signup",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Subscribe to our emails" },
    { "type": "text", "id": "description", "label": "Description", "default": "Get 10% off your first order." },
    { "type": "text", "id": "email_label", "label": "Email placeholder", "default": "Email address" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "Thanks for subscribing!" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F5F0EB" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#2C2C2C" },
    { "type": "color", "id": "button_color", "label": "Button", "default": "#2C2C2C" }
  ],
  "presets": [{ "name": "Footer newsletter signup" }],
  "tag": null,
  "class": "footer-newsletter-signup"
}
{% endschema %}